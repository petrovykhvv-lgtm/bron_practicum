# Локальная БД PostgreSQL. Скопируйте файл в .env и поправьте при необходимости.
DATABASE_URL="postgresql://USER@localhost:5432/verde_marea"
# Отдельная БД для интеграционных тестов ограничений (создаётся вручную: createdb verde_marea_test)
TEST_DATABASE_URL="postgresql://USER@localhost:5432/verde_marea_test"

# Часовой пояс ресторана: по нему считаются дни недели и время окон
RESTAURANT_TZ="Europe/Moscow"

# Учётные данные seed. Это тестовые значения только для локального запуска.
SEED_SUPER_ADMIN_EMAIL="superadmin@verdemarea.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe-Local-1"
SEED_DEMO_PASSWORD="Demo-Local-1"

# Рамка с демо-аккаунтами на главной и /login (для проверяющего). Показывается только при "true".
# Для запуска не на локальной машине удалите переменную или поставьте "false".
SHOW_DEMO_ACCOUNTS="true"

# Флаг Secure у cookie сессии. По умолчанию выключен: проект запускается локально по http://localhost.
# Включите "true" только если приложение открывается по HTTPS.
SESSION_COOKIE_SECURE="false"
